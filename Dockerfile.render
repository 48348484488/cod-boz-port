FROM python:3.13-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    SDL_VIDEODRIVER=x11 \
    LIBGL_ALWAYS_SOFTWARE=1 \
    EGL_PLATFORM=x11

RUN dpkg --add-architecture armhf \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        gcc-arm-linux-gnueabihf \
        qemu-user \
        libegl1:armhf \
        libgbm1:armhf \
        libgl1-mesa-dri:armhf \
        libgles1:armhf \
        libgles2:armhf \
        libsdl2-2.0-0:armhf \
        xauth \
        xvfb \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY . .

RUN python -m pip install --no-cache-dir numpy unicorn

EXPOSE 10000

ENTRYPOINT ["xvfb-run", "-a", "-s", "-screen 0 640x480x24"]
CMD ["python3", "remote_build.py"]
